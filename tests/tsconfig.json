{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@playwright/test", "node"],
    "noEmit": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["e2e/**/*.ts", "../playwright.config.ts"]
}
