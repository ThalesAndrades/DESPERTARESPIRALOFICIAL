# =====================================================================
# Despertar Espiral — variáveis de ambiente
# =====================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env (já está no .gitignore).
# =====================================================================


# ---------------------------------------------------------------------
# FRONTEND (Vite) — embarcadas no bundle do navegador
# ---------------------------------------------------------------------
# Obrigatórias se você quiser usar Supabase real (auth, DB, storage).
# Sem elas o app roda em modo local (localStorage).
#
# Onde achar:
#   Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------

VITE_SUPABASE_URL=https://dwblhkpodaabuuubloht.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL pública do site (usada em redirects de auth, links de email).
# Em dev: http://localhost:5173
# Em prod: https://despertarespiral.com
VITE_SITE_URL=http://localhost:5173

# Personalização (opcional)
# VITE_BRAND_NAME=Despertar Espiral

# ---------------------------------------------------------------------
# ANALYTICS / PIXELS (todos opcionais)
# ---------------------------------------------------------------------
# Cada provider só é inicializado se o ID estiver setado. Todos respeitam
# o consentimento LGPD do banner (analytics × marketing) automaticamente.
# ---------------------------------------------------------------------

# Google Analytics 4 (Measurement ID)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (container ID)
# VITE_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Facebook + Instagram Ads)
# Conta DespertarEspiral · ID 977610331341257
# VITE_META_PIXEL_ID=630846701068684
#
# Meta Conversions API (CAPI) — endpoint da Edge Function `meta-capi`.
# Quando setado, eventos do Pixel são duplicados via server-side com
# o mesmo event_id (deduplicação). Ganho típico: 20-30% mais eventos
# rastreados (recupera o que bloqueadores/ITP/iOS cortam).
# Como setar:
#   1. Em Eventos Manager → Configurações → API de Conversões → Gerar token
#   2. npx supabase secrets set META_CAPI_ACCESS_TOKEN=EAA...
#   3. npx supabase functions deploy meta-capi
#   4. Preencher a env abaixo com a URL pública da função:
# VITE_META_CAPI_ENDPOINT=https://<project>.functions.supabase.co/meta-capi

# TikTok Pixel
# VITE_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# Exige consentimento (LGPD) antes de carregar pixels — default: true.
# Em dev costuma ser útil deixar "false" para validar tags sem o banner.
# VITE_ANALYTICS_REQUIRE_CONSENT=true

# Log no console todos os disparos (útil para QA antes do lançamento).
# VITE_ANALYTICS_DEBUG=false


# =====================================================================
# EDGE FUNCTIONS — NÃO vão para o .env
# =====================================================================
# As variáveis abaixo são consumidas pelas Edge Functions do Supabase
# (server-side). Setar via:
#
#   npx supabase secrets set NOME=valor
#
# Ver lista do que está setado:
#   npx supabase secrets list
#
# Auto-injetadas pelo Supabase (NÃO precisa setar):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Você precisa setar:
#   - STRIPE_SECRET_KEY        → sk_live_... ou sk_test_...
#   - STRIPE_WEBHOOK_SECRET    → whsec_... (do endpoint criado no Stripe)
#   - RESEND_API_KEY           → re_... (do Resend Dashboard)
#   - SITE_URL                 → https://despertarespiral.com
#   - META_CAPI_ACCESS_TOKEN   → EAA... (token de acesso do Pixel da Meta)
#   - META_PIXEL_ID            → 630846701068684 (opcional, já é o default)
#   - META_TEST_EVENT_CODE     → TEST00000 (opcional, só em QA)
#   - DRIP_TICK_TOKEN          → segredo aleatório p/ proteger a função
#                                 drip-tick. Mesmo valor no cron caller.
#                                 Gere com: openssl rand -hex 32
# =====================================================================
